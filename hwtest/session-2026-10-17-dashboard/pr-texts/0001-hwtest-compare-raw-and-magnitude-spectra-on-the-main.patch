From 65e5deff126b9f01bed4d3e2a6f16bce81b36689 Mon Sep 17 00:00:00 2001
From: Mario Behn <tobias.libehn@gmail.com>
Date: Sun, 18 Oct 2026 07:21:41 +0200
Subject: [PATCH] hwtest: compare raw and magnitude spectra on the main lobe in
 dB

The linear correlation between the raw-capture spectrum and the magnitude
waterfall dropped to 0.7 whenever a tone near a half-bin position split
the single-frame peak across two bins, although the raw peak bin was the
expected one. Correlate the log spectra over the nine bins around the
magnitude peak instead (the noise floor elsewhere is uncorrelated between
the two captures). On hardware this gives 0.9994 to 1.0 on both boards
from 2.5 to 61.44 MS/s.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Signed-off-by: Mario Behn <tobias.libehn@gmail.com>
---
 maia-hdl/hwtest/rf_iq_check.py | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/maia-hdl/hwtest/rf_iq_check.py b/maia-hdl/hwtest/rf_iq_check.py
index 4ff9d59..88674f7 100644
--- a/maia-hdl/hwtest/rf_iq_check.py
+++ b/maia-hdl/hwtest/rf_iq_check.py
@@ -52,8 +52,11 @@ async def measure(host, name, br, expect=None):
         res['expected_bin'] = expect
         r = raw_spectrum(raw, int(m.argmax()), br)
         res['raw_peak'] = int(r.argmax())
-        res['raw_vs_mag_linear_corr'] = round(float(
-            np.corrcoef(r, m)[0, 1]), 4)
+        # log spectra over the main lobe (the noise floor elsewhere is
+        # uncorrelated between the two captures)
+        k = slice(int(m.argmax()) - 4, int(m.argmax()) + 5)
+        res['raw_vs_mag_log_corr'] = round(float(np.corrcoef(
+            np.log10(r[k] + 1e-9), np.log10(m[k] + 1e-9))[0, 1]), 4)
     return res, m, p
 
 
@@ -83,7 +86,7 @@ async def run(a):
                     # a tone near a half-bin position can put the peak of a
                     # single frame on either neighbouring bin
                     and all(abs(k - r['mag_peak']) <= 1 for k in r['iq_peak'])
-                    and r['raw_vs_mag_linear_corr'] > 0.99)
+                    and r['raw_vs_mag_log_corr'] > 0.99)
             ok &= good
             print(json.dumps(r), 'ok' if good else 'FAIL', flush=True)
         hwlib.stop_tx(a.tx)
