#!/bin/sh
# Boot-fault watcher, debug image only (7.3 boot loop, 2026-11-02).
# Hung task report after 10 s with backtraces of all CPUs, RCU stall report at 21 s, sysrq enabled. On the first fault
# line in the kernel log: save the log, dump the blocked tasks, all CPUs and all tasks through sysrq, save the log again.
# Up to three dumps per boot, one minute apart, so the later ones show whether the fault cleared.

case "$1" in
  start)
	echo 1 > /proc/sys/kernel/sysrq 2> /dev/null
	echo 1 > /proc/sys/kernel/hung_task_all_cpu_backtrace 2> /dev/null
	echo 10 > /proc/sys/kernel/hung_task_timeout_secs 2> /dev/null
	echo 21 > /sys/module/rcupdate/parameters/rcu_cpu_stall_timeout 2> /dev/null
	(
	n=0
	while [ $n -lt 3 ]; do
		if dmesg | grep -q -E 'blocked for more than|rcu: INFO|not taken|error: _ep_set_halt|BUG:|Oops'; then
			n=$((n + 1))
			dmesg > /tmp/fault_dmesg_${n}_pre.txt
			echo w > /proc/sysrq-trigger
			echo l > /proc/sysrq-trigger
			echo t > /proc/sysrq-trigger
			sleep 2
			dmesg > /tmp/fault_dmesg_${n}_post.txt
			echo "$(cut -d' ' -f1 /proc/uptime) fault dump $n usb0=$(ip -br -4 addr show usb0 2> /dev/null | awk '{print $3}')" >> /tmp/fault_log.txt
			sleep 58
		fi
		sleep 2
	done
	) &
	echo "bootwatch started"
	;;
  stop)
	;;
esac
